generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProposalStatus {
  pending
  revision
  approved
  rejected
}

enum RequestStatus {
  pending
  in_progress
  submitted
  revision
  completed
  cancelled
}

enum EnrollmentStatus {
  assigned
  in_progress
  completed
}

enum CourseApprovalStatus {
  draft
  submitted
  revision
  approved
  rejected
}

model Role {
  id    Int    @id @default(autoincrement()) @map("role_id")
  name  String @map("role_name")
  users User[]

  @@map("roles")
}

model Department {
  id          Int               @id @default(autoincrement()) @map("department_id")
  name        String            @map("department_name")
  description String?
  users       User[]
  programs    TrainingProgram[]

  @@map("departments")
}

model User {
  id                 Int     @id @default(autoincrement()) @map("user_id")
  role_id            Int
  department_id      Int
  full_name          String
  email              String  @unique
  status             String  @default("active")
  total_points       Int     @default(0)
  photo_url          String?
  notify_course      Boolean @default(true)
  notify_deadline    Boolean @default(true)
  notify_certificate Boolean @default(false)

  role       Role       @relation(fields: [role_id], references: [id])
  department Department @relation(fields: [department_id], references: [id])

  submitted_proposals      ProgramProposal[]  @relation("SubmittedBy")
  approved_proposals       ProgramProposal[]  @relation("ApprovedBy")
  created_programs         TrainingProgram[]  @relation("CreatedBy")
  course_requests_made     CourseRequest[]    @relation("RequestedBy")
  course_requests_assigned CourseRequest[]    @relation("TrainerOf")
  trained_courses          Course[]           @relation("TrainerCourse")
  enrollments              CourseEnrollment[]
  assessment_results       AssessmentResult[]
  notifications            Notification[]
  certificates             Certificate[]
  auditLogs                AuditLog[]

  @@index([department_id])
  @@index([role_id])
  @@map("users")
}

model ProgramProposal {
  id             Int            @id @default(autoincrement()) @map("proposal_id")
  submitted_by   Int
  department_id  Int
  reviewed_by    Int?
  proposal_title String
  description    String?
  status         ProposalStatus @default(pending)
  submitted_date DateTime       @default(now())
  review_date    DateTime?
  review_note    String?

  submitter User       @relation("SubmittedBy", fields: [submitted_by], references: [id])
  reviewer  User?      @relation("ApprovedBy", fields: [reviewed_by], references: [id])
  department Department @relation(fields: [department_id], references: [id])

  training_programs TrainingProgram[]

  @@index([submitted_by])
  @@index([department_id])
  @@index([status])
  @@map("program_proposals")
}

model TrainingProgram {
  id            Int      @id @default(autoincrement()) @map("program_id")
  proposal_id   Int?
  department_id Int?
  created_by    Int
  program_name  String
  description   String?
  program_type  String
  status        String   @default("draft")
  created_date  DateTime @default(now())

  proposal   ProgramProposal? @relation(fields: [proposal_id], references: [id])
  department Department?      @relation(fields: [department_id], references: [id])
  creator    User             @relation("CreatedBy", fields: [created_by], references: [id])
  courses    Course[]
  requests   CourseRequest[]

  @@index([department_id])
  @@index([created_by])
  @@map("training_programs")
}

model CourseRequest {
  id           Int           @id @default(autoincrement()) @map("request_id")
  program_id   Int
  course_id    Int?
  requested_by Int
  trainer_id   Int
  request_date DateTime      @default(now())
  status       RequestStatus @default(pending)

  program   TrainingProgram @relation(fields: [program_id], references: [id])
  course    Course?         @relation("CourseRequested", fields: [course_id], references: [id])
  requester User            @relation("RequestedBy", fields: [requested_by], references: [id])
  trainer   User            @relation("TrainerOf", fields: [trainer_id], references: [id])

  @@index([program_id])
  @@index([trainer_id])
  @@map("course_requests")
}

model Course {
  id              Int                  @id @default(autoincrement()) @map("course_id")
  program_id      Int
  trainer_id      Int
  assessment_id   Int?
  course_title    String
  description     String?
  approval_status CourseApprovalStatus @default(draft)
  deadline        DateTime?
  created_date    DateTime             @default(now())

  program      TrainingProgram    @relation(fields: [program_id], references: [id])
  trainer      User               @relation("TrainerCourse", fields: [trainer_id], references: [id])
  assessment   Assessment?        @relation("CourseAssessment", fields: [assessment_id], references: [id])
  materials    LearningMaterial[]
  assessments  Assessment[]       @relation("AssessmentCourse")
  enrollments  CourseEnrollment[]
  certificates Certificate[]
  requests     CourseRequest[]    @relation("CourseRequested")

  @@index([program_id])
  @@index([trainer_id])
  @@map("courses")
}

model LearningMaterial {
  id             Int      @id @default(autoincrement()) @map("material_id")
  course_id      Int
  material_title String
  material_type  String
  file_url       String
  uploaded_date  DateTime @default(now())

  course Course @relation(fields: [course_id], references: [id])

  @@index([course_id])
  @@map("learning_materials")
}

model Assessment {
  id            Int    @id @default(autoincrement()) @map("assessment_id")
  course_id     Int
  title         String
  passing_score Int    @default(70)

  course        Course             @relation("AssessmentCourse", fields: [course_id], references: [id])
  linked_course Course[]           @relation("CourseAssessment")
  questions     Question[]
  results       AssessmentResult[]

  @@index([course_id])
  @@map("assessments")
}

model Question {
  id             Int    @id @default(autoincrement()) @map("question_id")
  assessment_id  Int
  question_text  String
  correct_answer String

  assessment Assessment @relation(fields: [assessment_id], references: [id])

  @@index([assessment_id])
  @@map("questions")
}

model CourseEnrollment {
  id                    Int              @id @default(autoincrement()) @map("enrollment_id")
  user_id               Int
  course_id             Int
  assigned_date         DateTime         @default(now())
  completion_percentage Int              @default(0)
  status                EnrollmentStatus @default(assigned)

  user   User   @relation(fields: [user_id], references: [id])
  course Course @relation(fields: [course_id], references: [id])

  @@unique([user_id, course_id])
  @@index([user_id])
  @@index([course_id])
  @@map("course_enrollments")
}

model AssessmentResult {
  id             Int      @id @default(autoincrement()) @map("result_id")
  assessment_id  Int
  user_id        Int
  score          Float
  completed_date DateTime @default(now())

  assessment Assessment @relation(fields: [assessment_id], references: [id])
  user       User       @relation(fields: [user_id], references: [id])

  @@unique([assessment_id, user_id])
  @@index([assessment_id])
  @@index([user_id])
  @@map("assessment_results")
}

model Notification {
  id           Int      @id @default(autoincrement()) @map("notification_id")
  user_id      Int
  title        String
  message      String
  is_read      Boolean  @default(false)
  created_date DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("notifications")
}

model Certificate {
  id                 Int      @id @default(autoincrement()) @map("certificate_id")
  user_id            Int
  course_id          Int
  certificate_number String   @unique
  file_url           String?
  issue_date         DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id])
  course Course @relation(fields: [course_id], references: [id])

  @@unique([user_id, course_id])
  @@index([user_id])
  @@index([course_id])
  @@map("certificates")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  user_id      Int?
  action       String
  entity       String
  entity_id    Int?
  description  String?
  created_date DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("audit_logs")
}
